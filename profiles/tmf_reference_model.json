  "alcoa_plus_dimensions": {
    "attributable": "The identity of the person or system that created or modified data is known and recorded.",
    "legible": "Data is readable and understandable by humans, permanently retained, and not obscured or overwritten.",
    "contemporaneous": "Data is recorded at the time it is generated or observed, not backdated or delayed.",
    "original": "The first capture of data or a certified true copy, with source clearly identified.",
    "accurate": "Data is correct, complete, valid, and free from error or unexplained discrepancy.",
    "complete": "All data and metadata are present, including repeats, retests, and audit trails.",
    "consistent": "Data is logically coherent across records, systems, and time, with no contradictions.",
    "enduring": "Data is retained in a durable form for the required retention period, resistant to loss or degradation.",
    "available": "Data can be accessed and retrieved by authorized users when needed throughout the retention period."
  }
