FROM python:3.12-slim

RUN pip install --no-cache-dir google-api-python-client google-auth google-auth-httplib2

RUN useradd --system --uid 65532 --create-home arckon-forwarder
WORKDIR /app
COPY scripts/gworkspace_drive_forwarder.py /app/gworkspace_drive_forwarder.py
USER 65532

ENTRYPOINT ["python3", "/app/gworkspace_drive_forwarder.py"]
