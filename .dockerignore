# Never bake per-install license into the image — mounted per-customer at runtime
license.json

# Runtime credentials are mounted or injected at deploy time, never copied into images.
agent_config.json
agent_token.txt
.env
.env.*
*.env
deploy/gcp/.env

# Signed agent releases are mounted from the release host at runtime. Keeping
# historical archives out of the server image avoids exhausting Docker storage.
releases/

# Source-control metadata, local backups, and interpreter caches do not belong
# in runtime images and can make a build context unexpectedly large.
.git/
*.bak
__pycache__/
**/__pycache__/

# Ignore agent/dev files
CLAUDE.md
.claude/
AGENTS.md
.cursorrules
.windsurfrules
.aider.conf.yml
GEMINI.md
.gemini/
Modelfile
.continue/
DEVIN.md
.amazonq/
.tabnine_root
.copilot/
.github/copilot-instructions.md
